# build output (python3 build.py)
dist/
# headless-Chrome harness copies, browser profiles and screenshots
test/*_cdp/
test/cdp_kit/q/
**/shots/
**/chprof*/
# regression-suite run artefacts (baselines and goldens are tracked)
test/regress/perf/results/
test/regress/perf/ref_root/
test/regress/quality/out/
test/regress/tmp/
*.bak*
.DS_Store
node_modules/

# LaTeX build artefacts and run logs in notes
notes/**/*.log
notes/**/*.aux
notes/**/*.fls
notes/**/*.fdb_latexmk
notes/**/*.synctex.gz

# CI work folders (ci/README.md): reference builds and results
.ci/
# old source snapshots some unit tests compare with: node ci/snapshots.js restores them from the git history
notes/gate-morph-zp-r1/
notes/v16.2-candidate/
notes/v16.3-candidate/
# Python bytecode (the gates' Python scripts)
__pycache__/
