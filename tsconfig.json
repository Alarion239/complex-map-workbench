{
  // Type checking of the app's JavaScript (issue #20, phase 1): nothing is compiled or emitted, build.py is unchanged.
  //   npm run typecheck
  // app.js, gl.js, figure.js and construct.js are kept as ordered parts (src/app/, src/gl/, src/figure/, src/construct/;
  // issue #20, phase 2). A part is not a program of its
  // own (its top-level names are the closure's, and app.js's TAU, DEG, $ and h would clash with other files' globals),
  // so tsc checks the joined files instead: tools/join_src.js writes them to dist/tsc/ (npm run typecheck runs it
  // first, and npm ci runs it as "prepare"). Errors there are reported at the joined file's lines.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "strict": false,
    "skipLibCheck": true
  },
  "files": ["dist/tsc/app.js", "dist/tsc/gl.js", "dist/tsc/figure.js", "dist/tsc/construct.js"],
  "include": ["src/*.js", "types/*.d.ts"],
  "exclude": ["src/i18n_ru.js", "src/i18n_it.js", "src/seasong.js"]
}
